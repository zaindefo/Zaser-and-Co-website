# Google Tag Manager — container ID (e.g. GTM-XXXXXXX)
# If set, GTM loads on all pages. Configure GA4 inside GTM.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 — measurement ID (e.g. G-XXXXXXXXXX)
# Only used if GTM is NOT set. If GTM is set, configure GA4 inside GTM instead.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — site verification code
# Get this from Google Search Console > Settings > Ownership verification > HTML tag
# Paste only the content value, not the full meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
